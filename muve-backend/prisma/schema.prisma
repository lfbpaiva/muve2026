// --- gerador do client ---
generator client {
  provider = "prisma-client-js"
}

// --- datasource do banco ---
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- enums e models ---
enum TipoPessoa {
  PF
  PJ
}

enum TipoConta {
  ARTISTA
  CONTRATANTE
  ADMIN
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

model Usuario {
  id                    String     @id @default(uuid())
  nome                  String
  email                 String     @unique
  senha                 String
  telefone              String?
  fotoPerfil            String?
  bio                   String?
  cidade                String?
  estado                String?
  papeis                String[]   @default([])
  generos               String[]   @default([])
  redesSociais          Json?
  faixaCache            String?
  disponivelContratacao Boolean    @default(false)
  perfilPago            Boolean    @default(false)
  tipoPessoa            TipoPessoa @default(PF)
  tipoConta             TipoConta  @default(ARTISTA)
  cpf                   String?    @unique
  cnpj                  String?    @unique
  razaoSocial           String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  eventosCriados Evento[]           @relation("ContratanteEventos")
  inscricoes     EventApplication[] @relation("ArtistEventApplications")

  @@map("usuarios")
}

model Evento {
  id            Int      @id @default(autoincrement())
  titulo        String
  descricao     String?
  local         String
  cidade        String?
  estado        String?
  data          String?
  hora          String
  categoria     String?
  cacheEstimado String?
  contratando   Boolean  @default(true)
  contratanteId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  contratante Usuario?           @relation("ContratanteEventos", fields: [contratanteId], references: [id], onDelete: SetNull)
  inscricoes  EventApplication[]

  @@map("evento")
}

model EventApplication {
  id        String            @id @default(uuid())
  artistId  String
  eventId   Int
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  artist Usuario @relation("ArtistEventApplications", fields: [artistId], references: [id], onDelete: Cascade)
  event  Evento  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([artistId, eventId])
  @@index([artistId])
  @@index([eventId])
  @@map("event_applications")
}
